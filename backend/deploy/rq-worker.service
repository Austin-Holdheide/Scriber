[Unit]
Description=Scriber RQ worker (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/scriber/backend
EnvironmentFile=/opt/scriber/.env
Environment=PYTHONPATH=/opt/scriber/backend
ExecStart=/opt/scriber/venv/bin/python -m app.workers.worker --name scriber-worker-%i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
