{
  "dashboard": {
    "title": "Scriber Stack",
    "tags": [
      "scriber"
    ],
    "timezone": "browser",
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "LXC CPU % (Scriber stack)",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 1,
          "w": 12,
          "h": 8
        },
        "datasource": {
          "type": "prometheus",
          "uid": "cfy1exqh71vcwa"
        },
        "targets": [
          {
            "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"scriber-nodes\",mode=\"idle\"}[5m])) * 100), \"host\", \"supa 201\", \"instance\", \"192.168.1.201:.*\"), \"host\", \"app 202\", \"instance\", \"192.168.1.202:.*\"), \"host\", \"worker 203\", \"instance\", \"192.168.1.203:.*\"), \"host\", \"gpu1 204\", \"instance\", \"192.168.1.204:.*\"), \"host\", \"gpu2 205\", \"instance\", \"192.168.1.205:.*\")",
            "refId": "A",
            "legendFormat": "{{host}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 2,
        "title": "LXC RAM used %",
